# Copy to `.env` and set your URLs, then rebuild (`npm run build`).
# These are read at BUILD time by Vite — changing them requires a rebuild AND a
# "Reload" on the extension card in chrome://extensions.
#
# `host_permissions` in the manifest is derived automatically from the ORIGIN of
# these URLs, so you only set them here — the two can't drift.

# JobFit API base — must include the /api/v1 prefix (same value as the web app's
# NEXT_PUBLIC_API_URL).
#   local:      http://localhost:4000/api/v1
#   deployed:   https://your-api-host.example.com/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# JobFit web app origin — where the "Log in on jobfit.co" CTA sends the user.
#   local:      http://localhost:3000
#   deployed:   https://your-frontend.example.com
VITE_WEB_URL=http://localhost:3000
