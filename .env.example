# Copy to `.env` and adjust. These are read at build time by Vite.
# NOTE: the ORIGIN of VITE_API_URL must also be listed in `host_permissions`
# in manifest.config.ts, or the worker's fetch (and its cookie) is blocked.

# JobFit API base — must include the /api/v1 prefix (matches the web app's NEXT_PUBLIC_API_URL)
VITE_API_URL=http://localhost:4000/api/v1

# JobFit web app origin — where the "Log in on jobfit.co" CTA sends the user
VITE_WEB_URL=http://localhost:3000
